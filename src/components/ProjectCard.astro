---
import pageMedia from '../data/page-media.json';
const {project:p,featured=false,hidden=false}=Astro.props;
const thumbnail = p.image || pageMedia[p.id as keyof typeof pageMedia]?.['icon'];
const TAG_LIMIT=5;
// Collapse only when it hides at least two tags.
const hiddenTags=p.tags.length>TAG_LIMIT+1?p.tags.length-TAG_LIMIT:0;
---
<article class:list={['project-card',{featured}]} hidden={hidden} data-tags={p.tags.join('|')} data-search={`${p.title} ${p.subtitle??''} ${p.tags.join(' ')} ${p.summary}`.toLowerCase()}>
  <a class="project-image" href={`/work/${p.slug}/`} aria-label={`${p.title} 보기`}>
    {thumbnail&&<img src={thumbnail} alt={p.title} loading="lazy" decoding="async"/>}
  </a>
  <div class="project-info"><div class="project-meta"><span>{p.discipline}</span><span>{p.year}</span></div><h3><a href={`/work/${p.slug}/`}>{p.title}</a></h3><p>{p.summary}</p><ul class="tags" data-collapsible data-collapsed>{p.tags.map((t:string,i:number)=><li class:list={[{extra:hiddenTags>0&&i>=TAG_LIMIT}]}>{t}</li>)}{hiddenTags>0&&<li class="tag-more"><button type="button" class="tag-toggle" aria-expanded="false" data-more={`+${hiddenTags}`}>+{hiddenTags}</button></li>}</ul></div>
</article>
