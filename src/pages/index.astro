---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {projects} from '../data/projects';
import pageMedia from '../data/page-media.json';
const spotlight=projects.find(p=>p.slug==='xr-ai-pipeline')!;
// Slanted image strips behind the hero: the newest projects, using the same thumbnail as their cards.
const STRIP_COUNT=6;
// Some strips play a short muted clip (public/media/strip-<name>.mp4, with its first frame as the still).
const STRIP_CLIPS:Record<string,string>={'xr-ai-pipeline':'xr','mr-wand':'mr-wand','fps-project':'fps'};
const strips=projects.map(p=>({...p,src:p.image||pageMedia[p.id as keyof typeof pageMedia]?.['icon'],clip:STRIP_CLIPS[p.slug]})).filter(s=>s.src).slice(0,STRIP_COUNT);
// The featured project's strip starts out highlighted.
const firstActive=Math.max(0,strips.findIndex(s=>s.slug===spotlight.slug));
// Tag filters, most-used first; ties keep first-appearance order.
const tagCounts=new Map<string,number>();
for(const p of projects)for(const t of p.tags)tagCounts.set(t,(tagCounts.get(t)??0)+1);
const tags=[...tagCounts].sort((a,b)=>b[1]-a[1]);
const FILTER_LIMIT=9;
const PAGE_SIZE=9;
---
<Layout>
  <nav class="side-nav" aria-label="섹션 이동"><a href="#top" data-section="top"><span>홈</span></a><a href="#work" data-section="work"><span>프로젝트</span></a><a href="#about" data-section="about"><span>경력</span></a><a href="#contact" data-section="contact"><span>CONTACT</span></a></nav>
  <section class="hero" id="top">
    <div class="hero-strips">{strips.map((s,i)=><a class:list={["hero-strip",{"is-active":i===firstActive}]} href={`/work/${s.slug}/`} tabindex="-1" aria-hidden="true" style={`--i:${i}`} data-title={s.title} data-meta={`${s.discipline} · ${s.year}`} data-summary={s.summary}>{s.clip?<video src={`/media/strip-${s.clip}.mp4`} poster={`/media/strip-${s.clip}.jpg`} muted loop playsinline preload="none"/>:<img src={s.src} alt="" fetchpriority={i<4?"high":"auto"}/>}<span class="strip-label"><span class="strip-title glass">{s.title}<small>{s.discipline} · {s.year}</small></span></span></a>)}</div>
    <div class="hero-intro"><h1>Unity XR 프로그래머<br/>변고경입니다.</h1><p class="hero-description">XR, 메타버스, 실시간 버추얼 캐릭터 시스템 개발 경험과 AI 에이전트 활용 역량을 두루 갖춘 경력자입니다.</p><div class="hero-actions"><a class="button primary" href="#work">프로젝트 보기</a><a class="button" href="/work/about/">자기소개</a></div></div>
    <a class="hero-spot glass" href={`/work/${spotlight.slug}/`}><div class="spot-label"><span class="spot-live">NOW SHOWING</span><span class="spot-meta">{spotlight.discipline} · {spotlight.year}</span></div><div class="spot-body"><h2>{spotlight.title}</h2><p>{spotlight.summary}</p></div></a>
  </section>
  <section class="section work-section" id="work" aria-labelledby="work-title"><div class="section-heading"><p class="eyebrow">WORKS</p><h2 id="work-title">프로젝트</h2></div><div class="filter-bar"><div class="filters" role="group" aria-label="태그" data-collapsible data-collapsed><button data-filter="all" aria-pressed="true">전체<span>{projects.length}</span></button>{tags.map(([tag,count],i)=><button class:list={[{extra:i>=FILTER_LIMIT}]} data-filter={tag} aria-pressed="false">{tag}<span>{count}</span></button>)}{tags.length>FILTER_LIMIT&&<button type="button" class="tag-toggle" aria-expanded="false" data-more={`+${tags.length-FILTER_LIMIT}`}>+{tags.length-FILTER_LIMIT}</button>}</div><label class="search-box"><span aria-hidden="true">⌕</span><input type="search" id="project-search" placeholder="검색" aria-label="프로젝트 검색"/></label></div><div class="project-grid" id="project-grid" data-page-size={PAGE_SIZE}>{projects.map((p,i)=><ProjectCard project={p} hidden={i>=PAGE_SIZE}/>)}</div><nav class="pager" id="pager" aria-label="프로젝트 페이지"></nav><div class="empty-state" id="empty-state" hidden><p>검색 결과가 없습니다.</p><button id="reset-filters" class="button">초기화</button></div></section>
  <section class="section" id="about" aria-labelledby="about-title"><div class="section-heading"><p class="eyebrow">CAREER</p><h2 id="about-title">경력</h2></div><div class="career"><div class="profile glass"><img src="/media/28717948-1805-44cb-bec5-c1f7520e65ef.jpg" alt="변고경" loading="lazy"/><strong>변고경</strong><span class="profile-role">Programmer, Unity XR Developer</span><p>Unity와 C#으로 XR, 메타버스, 실시간 캐릭터 시스템을 개발해 왔습니다.<br/>새로운 기술의 활용 방법과 워크플로우 개선을 중점으로 생각합니다.<br/>최근에는 AI 에이전트를 활용한 개발 워크플로우 개선에 몰두하고 있습니다.</p><a class="text-link" href="/work/about/">자기소개 →</a></div><div class="timeline"><a href="/work/blackbomb/"><span class="timeline-date">2024.06 — 2026.04</span><div><h3>블랙밤</h3><p>소프트웨어 엔지니어</p><ul><li>버추얼 캐릭터 프로젝트 개발<ul><li>유니티 엔진 기반 PC용 버추얼 캐릭터 앱 개발</li><li>유니티 엔진 기반 아이폰용 페이셜 캡쳐 앱 개발</li></ul></li><li>넥슨 엘소드 콘서트 엘스타2 모션 캡쳐 어시스트 담당</li><li>2D 애니메이션 개발자용 어도비 애프터 이펙트 툴 개발</li></ul></div></a><a href="/work/blackbomb/"><span class="timeline-date">2024.01 — 2024.05</span><div><h3>블랙밤</h3><p>프리랜서</p><ul><li>버추얼 캐릭터 관련 프로젝트 개발 작업 용역</li></ul></div></a><a href="/work/frontis/"><span class="timeline-date">2020.09 — 2023.05</span><div><h3>한컴 프론티스</h3><p>서비스본부 클라이언트팀 연구원 · 유니티 클라이언트 프로그래머</p><ul><li>메타버스 플랫폼 "아즈메타" iOS, Android 개발 및 출시</li><li>코드게이트 메타버스 앱 iOS, Android 개발 및 출시</li><li>한컴 스토어 메타버스 앱 iOS, Android 개발 및 출시</li><li>가상현실 회의 플랫폼 "XR 판도라" 오큘러스 퀘스트 2 버전 개발</li></ul></div></a><a href="/work/time-of-vengeance/"><span class="timeline-date">2020.04 — 2020.06</span><div><h3>어트랙션 기반 VR 콘텐츠 개발 프로젝트 과정</h3><p>Time of Vengeance (2인 팀)</p></div></a></div></div></section>
  <section class="contact-section" id="contact"><h2>CONTACT</h2><a href="mailto:kikikg6@naver.com">kikikg6@naver.com</a></section>
</Layout>
<script>
  let category='all';
  const input=document.querySelector<HTMLInputElement>('#project-search')!;
  const cards=[...document.querySelectorAll<HTMLElement>('#project-grid .project-card')];
  const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const pager=document.querySelector<HTMLElement>('#pager')!;
  const pageSize=Number(document.querySelector<HTMLElement>('#project-grid')!.dataset.pageSize);
  let matched=cards,page=1;
  // Page numbers to show: all when few, otherwise first/last plus a window around the current page.
  function pageItems(total:number,current:number):(number|'gap')[]{if(total<=7)return Array.from({length:total},(_,i)=>i+1);if(current<=4)return [1,2,3,4,5,'gap',total];if(current>=total-3)return [1,'gap',total-4,total-3,total-2,total-1,total];return [1,'gap',current-1,current,current+1,'gap',total];}
  const chevron=(d:string)=>`<svg viewBox="0 0 8 12" width="8" height="12" aria-hidden="true"><path d="${d}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
  function render(){const total=Math.max(1,Math.ceil(matched.length/pageSize));page=Math.min(page,total);const start=(page-1)*pageSize;cards.forEach(c=>c.hidden=true);matched.slice(start,start+pageSize).forEach(c=>c.hidden=false);
    pager.hidden=total<=1;pager.innerHTML=total<=1?'':`<button type="button" data-page="${page-1}" aria-label="이전 페이지" ${page===1?'disabled':''}>${chevron('M6 1L1.5 6 6 11')}</button>`+pageItems(total,page).map(n=>n==='gap'?'<span class="pager-gap">…</span>':`<button type="button" data-page="${n}" ${n===page?'aria-current="page"':''}>${n}</button>`).join('')+`<button type="button" data-page="${page+1}" aria-label="다음 페이지" ${page===total?'disabled':''}>${chevron('M2 1l4.5 5L2 11')}</button>`;}
  function filter(){const query=input.value.trim().toLowerCase();matched=cards.filter(card=>(category==='all'||card.dataset.tags!.split('|').includes(category))&&(!query||card.dataset.search?.includes(query)));page=1;render();document.querySelector<HTMLElement>('#empty-state')!.hidden=matched.length>0;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.filter===category)));}
  pager.addEventListener('click',e=>{const b=(e.target as HTMLElement).closest<HTMLButtonElement>('button[data-page]');if(!b||b.disabled)return;page=Number(b.dataset.page);render();document.querySelector('#work')!.scrollIntoView({behavior:'smooth'});});
  render();
  // Hero strips: highlight one strip at a time and show its project in the NOW SHOWING panel;
  // the cycle pauses while the pointer is over the hero, and hovering a strip takes over.
  const strips=[...document.querySelectorAll<HTMLAnchorElement>('.hero-strip')];
  const spot=document.querySelector<HTMLAnchorElement>('.hero-spot')!;
  const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)').matches;
  let activeStrip=Math.max(0,strips.findIndex(s=>s.classList.contains('is-active')));
  let stripTimer:number|undefined;
  const showStrip=(i:number)=>{if(i===activeStrip)return;activeStrip=i;strips.forEach((s,j)=>s.classList.toggle('is-active',j===i));
    const {title,meta,summary}=strips[i].dataset;spot.setAttribute('href',strips[i].getAttribute('href')!);spot.querySelector('.spot-meta')!.textContent=meta!;spot.querySelector('h2')!.textContent=title!;spot.querySelector('.spot-body p')!.textContent=summary!;
    if(!reducedMotion)spot.querySelector('.spot-body')!.animate([{opacity:0,transform:'translateY(6px)'},{opacity:1,transform:'none'}],{duration:450,easing:'ease-out'});playClip();};
  // Only the active strip's clip plays, from the start; phones and reduced motion keep the still frame.
  const clipsAllowed=!reducedMotion&&!matchMedia('(max-width: 760px)').matches;
  function playClip(){strips.forEach((s,j)=>{const v=s.querySelector('video');if(!v)return;if(j===activeStrip&&clipsAllowed){v.currentTime=0;v.play().catch(()=>{});}else v.pause();});}
  const stopStrips=()=>clearInterval(stripTimer);
  const startStrips=()=>{stopStrips();if(reducedMotion)return;stripTimer=setInterval(()=>showStrip((activeStrip+1)%strips.length),3200);};
  // Hold the cycle while the pointer or keyboard focus is in the hero, so a focused link keeps its project.
  let pointerInHero=false;
  strips.forEach((s,i)=>s.addEventListener('mouseenter',()=>showStrip(i)));
  const hero=document.querySelector<HTMLElement>('.hero')!;
  const heroHeld=()=>pointerInHero||hero.contains(document.activeElement);
  hero.addEventListener('mouseenter',()=>{pointerInHero=true;stopStrips();});
  hero.addEventListener('mouseleave',()=>{pointerInHero=false;if(!heroHeld())startStrips();});
  hero.addEventListener('focusin',stopStrips);
  hero.addEventListener('focusout',e=>{if(!pointerInHero&&!hero.contains(e.relatedTarget as Node|null))startStrips();});
  document.addEventListener('visibilitychange',()=>document.hidden||heroHeld()?stopStrips():startStrips());
  playClip();startStrips();
  // Side nav: mark the section currently in view (the last one whose top has passed 40% of the screen).
  const sideLinks=[...document.querySelectorAll<HTMLAnchorElement>('.side-nav a')];
  const sections=sideLinks.map(a=>document.getElementById(a.dataset.section!)!);
  function spy(){const atBottom=scrollY+innerHeight>=document.documentElement.scrollHeight-2;let current=0;sections.forEach((sec,i)=>{if(sec.getBoundingClientRect().top<=innerHeight*.4)current=i;});if(atBottom)current=sections.length-1;sideLinks.forEach((a,i)=>a.toggleAttribute('aria-current',i===current));}
  addEventListener('scroll',spy,{passive:true});addEventListener('resize',spy);spy();
  buttons.forEach(b=>b.addEventListener('click',()=>{category=b.dataset.filter!;filter();}));input.addEventListener('input',filter);
  document.querySelector('#reset-filters')?.addEventListener('click',()=>{category='all';input.value='';filter();});
  // "+N" toggles for the filter bar and each card's tag list.
  document.addEventListener('click',e=>{const b=(e.target as HTMLElement).closest<HTMLButtonElement>('.tag-toggle');if(!b)return;const collapsed=b.closest('[data-collapsible]')!.toggleAttribute('data-collapsed');b.textContent=collapsed?b.dataset.more!:'접기';b.setAttribute('aria-expanded',String(!collapsed));});
</script>
