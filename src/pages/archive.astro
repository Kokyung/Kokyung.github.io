---
import Layout from '../layouts/Layout.astro';
import raw from '../data/notion.json';
import {pages,urlFor,idOf,plain} from '../lib/content';
import {projects} from '../data/projects';
// Top-level pages only: the portfolio root, its direct children, and project pages.
const ROOT_ID='2d5c0c7fed3880d19ad0d50afc5f7f54';
// Projects use their own date; other pages fall back to the "(2024.01 ~ 2026.04)" range in the Notion title.
const dateOf=(id:string)=>{
  const project=projects.find(x=>x.id===id);
  if(project&&/^\d{4}\./.test(project.date))return project.date;
  const m=plain(raw.find(r=>r.id===id)?.title||'').match(/\((\d{4}\.\d{2})(?:\.\d{2})?\s*~\s*(\d{4}\.\d{2})?/);
  return m?(m[2]?`${m[1]} — ${m[2]}`:m[1]):'';
};
const listed=pages
  .filter(p=>!p.parent||idOf(p.parent)===ROOT_ID||projects.some(x=>x.id===p.id))
  .map(p=>{const date=dateOf(p.id);return {...p,date,sortDate:date.slice(0,7).replace('.','')};})
  .sort((a,b)=>b.sortDate.localeCompare(a.sortDate));
---
<Layout title="아카이브 · 변고경"><section class="section archive-page"><h1>아카이브</h1><input class="archive-search" type="search" id="archive-search" placeholder="제목, 본문 검색" aria-label="아카이브 검색"/><div class="archive-toolbar"><p id="archive-count" aria-live="polite">{listed.length}개</p><div class="archive-sort"><select id="sort-key" aria-label="정렬 기준" autocomplete="off"><option value="title">텍스트</option><option value="date" selected>날짜</option></select><button type="button" id="sort-dir" class="sort-dir" data-dir="desc" aria-label="내림차순" title="내림차순"><svg class="icon-desc" viewBox="0 0 18 16" width="18" height="16" aria-hidden="true"><path d="M3 2v11M1 11l2 2.5L5 11M8 3h9M8 8h9M8 13h9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="icon-asc" viewBox="0 0 18 16" width="18" height="16" aria-hidden="true"><path d="M3 14V3M1 5l2-2.5L5 5M8 3h9M8 8h9M8 13h9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div></div><div class="archive-list" id="archive-list">{listed.map(p=><a href={urlFor(p.id)} data-document data-title={plain(p.title)} data-date={p.sortDate} data-search={`${p.title} ${plain(p.content)}`.toLowerCase()}><div><h2>{plain(p.title)}</h2><span>{p.parent?plain(pages.find(x=>x.url===p.parent)?.title||'개인 프로젝트'):p.id===ROOT_ID?'포트폴리오':'개인 프로젝트'}</span></div>{p.date&&<time>{p.date}</time>}</a>)}</div><p id="archive-empty" hidden>검색 결과가 없습니다.</p></section></Layout>
<script>
  const input=document.querySelector<HTMLInputElement>('#archive-search')!;
  const list=document.querySelector<HTMLElement>('#archive-list')!;
  const rows=[...list.querySelectorAll<HTMLElement>('[data-document]')];
  let key='date',dir='desc';
  const dirButton=document.querySelector<HTMLButtonElement>('#sort-dir')!;
  function search(){let n=0;const q=input.value.trim().toLowerCase();rows.forEach(r=>{r.hidden=!r.dataset.search?.includes(q);if(!r.hidden)n++;});document.querySelector('#archive-count')!.textContent=`${n}개`;document.querySelector<HTMLElement>('#archive-empty')!.hidden=n>0;}
  // Undated pages always stay at the end, whichever direction is chosen.
  function sort(){const sign=dir==='asc'?1:-1;rows.sort((a,b)=>{if(key==='date'){const da=a.dataset.date!,db=b.dataset.date!;if(!da||!db)return da?-1:db?1:0;return sign*da.localeCompare(db);}return sign*a.dataset.title!.localeCompare(b.dataset.title!,'ko');}).forEach(r=>list.append(r));const label=dir==='asc'?'오름차순':'내림차순';dirButton.setAttribute('aria-label',label);dirButton.title=label;dirButton.dataset.dir=dir;}
  input.addEventListener('input',search);
  const keySelect=document.querySelector<HTMLSelectElement>('#sort-key')!;
  keySelect.addEventListener('change',()=>{key=keySelect.value;sort();});
  dirButton.addEventListener('click',()=>{dir=dir==='asc'?'desc':'asc';sort();});
</script>
