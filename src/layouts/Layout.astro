---
import '../styles/global.css';
const {title='변고경 포트폴리오', description='Unity XR 프로그래머 변고경의 포트폴리오.'}=Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#171c19"/>
    <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 이동</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="홈"><span class="brand-mark">b<span>kk</span></span></a>
      <nav aria-label="주요 메뉴"><a href="/#work">프로젝트</a><a href="/#about">경력</a><a href="/archive/">문서</a><a class="contact-link" href="mailto:kikikg6@naver.com">CONTACT</a><a class="github-link" href="https://github.com/Kokyung" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg viewBox="0 0 16 16" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a></nav>
    </header>
    <main id="main"><slot/></main>
    <footer class="site-footer"><div><a href="mailto:kikikg6@naver.com">kikikg6@naver.com</a><p>© {new Date().getFullYear()} BYUN KOKYUNG</p></div></footer>
    <script>
      const header = document.querySelector('.site-header');
      const update=()=>header?.classList.toggle('scrolled',window.scrollY>20);
      addEventListener('scroll',update,{passive:true});update();
    </script>
  </body>
</html>
